# Password for /admin (at least 8 characters). Set this in Vercel → Settings → Environment Variables.
ADMIN_PASSWORD=change-me-to-a-long-password

# Optional: separate secret for signing admin sessions. Defaults to one derived from ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=

# Added automatically by Vercel when you connect a Blob store (Storage → Create → Blob).
# Leave unset locally: uploads are then saved to public/uploads and .data/site.json.
# BLOB_READ_WRITE_TOKEN=
